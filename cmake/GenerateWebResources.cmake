# ╔════════════════════════════════════════════════════════════════════════════╗
# ║  cmake/GenerateWebResources.cmake — embed web/ assets into the binary     ║
# ║                                                                          ║
# ║  Script-mode CMake (run via `cmake -P` by a custom command). Reads every  ║
# ║  file listed in the manifest, wraps it in C++ raw string literals         ║
# ║  (chunked to stay under MSVC's string-length limit), and writes           ║
# ║  web_resources.cpp implementing web_resources.hpp.                        ║
# ║                                                                          ║
# ║  Expected variables (passed with -D):                                    ║
# ║    WEB_DIR     — absolute path to the web/ source directory               ║
# ║    MANIFEST    — path of a cmake file setting WEB_FILES (relative paths)  ║
# ║    OUTPUT      — path of the generated .cpp                              ║
# ╚════════════════════════════════════════════════════════════════════════════╝

include("${MANIFEST}")

# MSVC caps a single string literal at 65,520 bytes; chunk well below that
# and split at newline boundaries so concatenation is byte-exact.
set(CHUNK_SIZE 60000)

set(out "")
string(APPEND out "// Generated by cmake/GenerateWebResources.cmake — DO NOT EDIT.\n")
string(APPEND out "// Regenerated automatically when any file under web/ changes.\n")
string(APPEND out "#include \"kairos/http/web_resources.hpp\"\n\n")
string(APPEND out "namespace kairos::http::web_resources {\n\n")
string(APPEND out "const std::vector<WebResource>& embedded_resources() {\n")
string(APPEND out "    static const std::vector<WebResource> resources = {\n")

foreach(rel_path IN LISTS WEB_FILES)
    file(READ "${WEB_DIR}/${rel_path}" content)

    # Pick a raw-literal delimiter that does not collide with the content
    # (the terminator sequence `)DELIM"` must not occur inside).
    set(delimiter "kairos")
    while(true)
        string(FIND "${content}" ")${delimiter}\"" collision_pos)
        if(collision_pos EQUAL -1)
            break()
        endif()
        set(delimiter "${delimiter}x")
    endwhile()

    # Emit as one or more adjacent raw literals (compiler concatenates).
    string(APPEND out "        {\"${rel_path}\",")
    set(remaining "${content}")
    set(chunks 0)
    while(NOT remaining STREQUAL "")
        string(LENGTH "${remaining}" remaining_len)
        if(remaining_len LESS_EQUAL CHUNK_SIZE)
            set(chunk "${remaining}")
            set(remaining "")
        else()
            string(SUBSTRING "${remaining}" 0 ${CHUNK_SIZE} chunk)
            # Extend the chunk to the last newline so cuts are lossless.
            string(FIND "${chunk}" "\n" cut_pos REVERSE)
            if(cut_pos GREATER_EQUAL 0)  # valid compound spelling
                math(EXPR take "${cut_pos} + 1")
                string(SUBSTRING "${chunk}" 0 ${take} chunk)
                string(SUBSTRING "${remaining}" ${take} -1 remaining)
            else()
                string(SUBSTRING "${remaining}" ${CHUNK_SIZE} -1 remaining)
            endif()
        endif()
        if(chunks GREATER 0)
            string(APPEND out "\n            ")
        endif()
        string(APPEND out " R\"${delimiter}(${chunk})${delimiter}\"")
        math(EXPR chunks "${chunks} + 1")
    endwhile()
    string(APPEND out "},\n")
endforeach()

string(APPEND out "    };\n")
string(APPEND out "    return resources;\n")
string(APPEND out "}\n\n")
string(APPEND out "}  // namespace kairos::http::web_resources\n")

# Write only when the content differs, so the build timestamp does not
# bounce on every reconfigure.
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing)
else()
    set(existing "")
endif()
if(NOT existing STREQUAL "${out}")
    file(WRITE "${OUTPUT}" "${out}")
    message(STATUS "Web resources: embedded ${WEB_COUNT} assets")
endif()
